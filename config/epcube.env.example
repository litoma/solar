# コピーして使う: cp config/epcube.env.example config/epcube.env && chmod 600 config/epcube.env
# ゲートウェイのURL(DHCP予約した固定IPを推奨。mDNS名 epcube-gw.local は解決できない場合あり)
EPCUBE_GW_URL=http://192.168.0.36
# スケッチの API_TOKEN を設定した場合のみ(X-Api-Token ヘッダで送信)
EPCUBE_GW_TOKEN=
# SQLiteファイル
EPCUBE_DB_PATH=/home/litoma/solar/var/epcube.db
# Cloudflare Worker (D1) への差分同期 (デプロイ後に設定すると once 実行時に自動同期)
#EPCUBE_SYNC_URL=https://epcube-solar.<your-subdomain>.workers.dev
#EPCUBE_SYNC_TOKEN=
# 以下は任意(既定値)
#EPCUBE_LATITUDE=35.7356
#EPCUBE_LONGITUDE=139.6517
#EPCUBE_HTTP_TIMEOUT=10
#EPCUBE_SNAPSHOT_INTERVAL=600
#EPCUBE_STALE_SEC=300
#EPCUBE_LOW_N=3
