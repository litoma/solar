[Unit]
Description=EP CUBE gateway minute ingest (one shot)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=litoma
Group=litoma
EnvironmentFile=/home/litoma/solar/config/epcube.env
ExecStart=/home/litoma/solar/.venv/bin/epcube-collector once
TimeoutStartSec=50
Nice=10
UMask=0077
# 簡易ハードニング: 書き込みはDBディレクトリのみ
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/litoma/solar/var
